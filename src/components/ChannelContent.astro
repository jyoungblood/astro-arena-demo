---
import type { ArenaEntryData } from "astro-arena";
import ResourceCard from "./ResourceCard.astro";
import ResourceHeader from "./ResourceHeader.astro";

interface ChannelEntry {
  data: ArenaEntryData;
  id: string;
}

interface Props {
  blockHrefBase?: string;
  class?: string;
  description?: string | undefined;
  entries: readonly ChannelEntry[];
  channelHref?: string | undefined;
  title: string;
}

const {
  blockHrefBase,
  class: className,
  description,
  entries,
  channelHref,
  title,
} = Astro.props;
---

<section class:list={["channel-content", className]}>
  <ResourceHeader
    class="channel-header"
    href={channelHref}
    linkLabel={`View ${title} on Are.na`}
    title={title}
  >
    {description && <p class="lede">{description}</p>}
  </ResourceHeader>
  {Astro.slots.has("status") && (
    <div class="channel-status">
      <slot name="status" />
    </div>
  )}
  {entries.length > 0 && (
    <div class="channel-gallery">
      <div class="grid">
        {entries.map((entry) => (
          <ResourceCard
            data={entry.data}
            id={entry.id}
            href={blockHrefBase && entry.data.type !== "Channel"
              ? `${blockHrefBase}/${entry.id}`
              : undefined}
          />
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .channel-status {
    margin-bottom: 1rem;
  }
</style>
