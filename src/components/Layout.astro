---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A playground for the astro-arena content loaders"
    />
    <title>{title} · astro-arena</title>
    <style is:global>
      :root {
        color-scheme: light;
        font-family: ui-sans-serif, system-ui, sans-serif;
        color: #161616;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
      }
      a {
        color: inherit;
      }
      /* body > header, main { width: min(1100px, calc(100% - 2rem)); margin-inline: auto; } */
      body > header {
        position: fixed;
        z-index: 10;
        top: 0;
        right: 0;
        display: flex;
        gap: 1rem;
        align-items: baseline;
        justify-content: space-between;
        padding: 1.5rem;
      }
      nav {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.8rem;
        font-size: 0.9rem;
      }
      nav a {
        display: inline-flex;
        align-items: center;
        text-decoration-thickness: from-font;
        text-underline-offset: 0.12em;
      }
      nav a:hover,
      nav a:focus-visible {
        background: #161616;
        color: #fff;
        text-decoration: none;
      }
      nav a:focus-visible {
        outline: 2px solid #161616;
        outline-offset: 2px;
      }
      .nav-logo img {
        display: block;
        width: auto;
        height: 1em;
        transform: translateY(1px);
      }
      .nav-logo:hover img,
      .nav-logo:focus-visible img {
        filter: invert(1);
      }
      /* main { padding: 3rem 0 6rem; } */
      h1 {
        max-width: 14ch;
        font-size: clamp(2.5rem, 8vw, 6rem);
        margin: 0 0 1rem;
        text-transform: uppercase;
      }
      .lede {
        max-width: 60ch;
        color: #555;
        font-size: 1.1rem;
        margin-bottom: 3rem;
      }
      .channel-gallery {
        container: channel-gallery / inline-size;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr;
        grid-auto-flow: dense;
        grid-auto-rows: 66.667cqw;
        gap: 0;
        margin: 0;
        padding: 0;
      }
      .card {
        position: relative;
        min-width: 0;
        min-height: 0;
        overflow: hidden;
        background: #161616;
        color: #fff;
        text-decoration: none;
      }
      .card img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .card__metadata {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-rows: auto 1fr auto;
        gap: 0.5rem;
        padding: clamp(0.5rem, 1vw, 1rem);
        background: rgb(72 72 72 / 0.5);
        opacity: 0;
        /* transition: opacity 160ms ease-out; */
      }
      .card:hover .card__metadata,
      .card:focus-visible .card__metadata {
        opacity: 1;
      }
      .card:focus-visible {
        z-index: 1;
        outline: 3px solid #fff;
        outline-offset: -3px;
      }
      .card--text .card__metadata {
        opacity: 1;
        background: rgb(0, 0, 0);
      }
      .card__type,
      .card__id {
        color: eee;
        font-size: 0.625rem;
        line-height: 1;
        /* letter-spacing: 0.06em; */
        text-transform: uppercase;
      }
      .card__id {
        justify-self: end;
        font-variant-numeric: tabular-nums;
      }
      .card__label {
        display: -webkit-box;
        grid-column: 1 / -1;
        grid-row: 3;
        align-self: end;
        max-width: 32ch;
        overflow: hidden;
        overflow-wrap: anywhere;
        color: #fff;
        font-size: clamp(0.75rem, 1vw, 0.875rem);
        text-wrap: balance;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 4;
      }
      .eyebrow {
        color: #777;
        font-size: 0.7rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }
      .content {
        max-width: 720px;
      }
      .content img {
        max-width: 100%;
        height: auto;
      }
      @container channel-gallery (min-width: 40rem) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
          grid-auto-rows: 33.333cqw;
        }
        .card:nth-child(6n + 1) {
          grid-column: span 2;
          grid-row: span 2;
        }
        .card:nth-child(6n + 2) {
          grid-column: span 2;
        }
        .card:nth-child(6n + 3),
        .card:nth-child(6n + 4) {
          grid-row: span 2;
        }
      }

      @container channel-gallery (min-width: 64rem) {
        .grid {
          grid-template-columns: repeat(4, 1fr);
          grid-auto-rows: 16.667cqw;
        }
        .card:nth-child(6n + 1) {
          grid-column: span 1;
          grid-row: span 1;
        }
        .card:nth-child(6n + 2) {
          grid-column: span 1;
        }
        .card:nth-child(6n + 3),
        .card:nth-child(6n + 4) {
          grid-row: span 1;
        }
        .card:nth-child(60n + 1),
        .card:nth-child(60n + 19),
        .card:nth-child(60n + 36),
        .card:nth-child(60n + 39),
        .card:nth-child(60n + 58) {
          grid-column: span 2;
          grid-row: span 2;
        }
        .card:nth-child(60n + 6),
        .card:nth-child(60n + 10),
        .card:nth-child(60n + 17),
        .card:nth-child(60n + 23),
        .card:nth-child(60n + 28),
        .card:nth-child(60n + 33),
        .card:nth-child(60n + 42),
        .card:nth-child(60n + 46),
        .card:nth-child(60n + 52),
        .card:nth-child(60n + 60) {
          grid-column: span 2;
        }
        .card:nth-child(60n + 4),
        .card:nth-child(60n + 5),
        .card:nth-child(60n + 8),
        .card:nth-child(60n + 13),
        .card:nth-child(60n + 14),
        .card:nth-child(60n + 16),
        .card:nth-child(60n + 29),
        .card:nth-child(60n + 34),
        .card:nth-child(60n + 35),
        .card:nth-child(60n + 38),
        .card:nth-child(60n + 44),
        .card:nth-child(60n + 45),
        .card:nth-child(60n + 51),
        .card:nth-child(60n + 57),
        .card:nth-child(60n + 59) {
          grid-row: span 2;
        }
      }

      @media (hover: none) {
        .card__metadata {
          opacity: 1;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .card__metadata {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div></div>
      <nav aria-label="Main navigation">
        <a
          class="nav-logo"
          href="https://github.com/jyoungblood/astro-arena"
          target="_blank"
          rel="noopener"
          aria-label="GitHub repository"
        >
          <img src="/astro-arena.svg" alt="" />
        </a>
        <a href="/">Channel</a>
        <a href="/block">Block</a>
        <a href="/live">Live</a>
        <a href="/sdk">SDK</a>
        <a href="/private">Private</a>
        <a
          href="https://github.com/jyoungblood/astro-arena-demo"
          target="_blank"
          rel="noopener">GitHub ↗</a
        >
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
