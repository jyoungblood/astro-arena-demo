---
import type { ArenaEntryData } from "astro-arena";

interface Props {
  data: ArenaEntryData;
  href?: string | undefined;
  id: string;
}

const { data, href, id } = Astro.props;
const image = "image" in data ? data.image?.medium?.src : undefined;
const label = data.title || `${data.type} ${data.id}`;
const Tag = href ? "a" : "article";
---

<Tag class:list={["card", !image && "card--text"]} href={href}>
  {image && (
    <img
      src={image}
      alt={("image" in data && data.image?.alt_text) || ""}
    />
  )}
  <div class="card__metadata">
    <div class="card__type">{data.type}</div>
    <div class="card__id">{id}</div>
    <div class="card__label">{label}</div>
  </div>
</Tag>
