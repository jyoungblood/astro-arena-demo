---
export const prerender = true;

import { getCollection, render } from "astro:content";
import BlockContent from "../components/BlockContent.astro";
import Layout from "../components/Layout.astro";

const [entry] = await getCollection("featured");
if (!entry) throw new Error("The featured block collection is empty.");
const { Content } = await render(entry);
---

<Layout title={entry.data.title || "Featured block"}>
  <BlockContent data={entry.data} id={entry.id}>
    <Content />
  </BlockContent>
</Layout>
