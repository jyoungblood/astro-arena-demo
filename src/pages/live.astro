---
import { getCollection } from "astro:content";
import Annotation from "../components/Annotation.astro";
import ChannelContent from "../components/ChannelContent.astro";
import Layout from "../components/Layout.astro";

const entries = await getCollection("liveSnapshot");
---

<Layout title="Live collection example">
  <ChannelContent
    blockHrefBase="/blocks"
    channelHref="https://www.are.na/are-na-team/arena-influences"
    entries={entries}
    title="Build-time snapshot"
  >
    <Annotation slot="status">
      <p>
        This static demo loaded {entries.length} entries during the build. Cloudflare Pages serves the generated HTML and does not request Are.na data when you open this page.
      </p>
      <p>
        The <code>src/live.config.ts</code> file shows the live collection configuration. In an SSR application, <code>getLiveCollection()</code> loads current data for each request. Live output requires on-demand rendering and an adapter, so this Pages demo does not display it. <a href="https://docs.astro.build/en/guides/content-collections/#live-content-collections">Read the Astro live content guide.</a>
      </p>
    </Annotation>
  </ChannelContent>
</Layout>
