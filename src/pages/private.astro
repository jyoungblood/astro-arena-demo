---
export const prerender = true;

import { getCollection } from "astro:content";
import Annotation from "../components/Annotation.astro";
import ChannelContent from "../components/ChannelContent.astro";
import Layout from "../components/Layout.astro";
import { privateConfiguration } from "../private.config";

const entries = privateConfiguration ? await getCollection("privateReferences") : [];
const [channel] = privateConfiguration ? await getCollection("privateChannel") : [];
const title = channel?.data.resource.title ?? "Private channel";
const description = channel?.data.resource.description?.plain;
const channelUrl = channel
  ? `https://www.are.na/${channel.data.resource.owner.slug}/${channel.data.resource.slug}`
  : "https://www.are.na";
---

<Layout title={title}>
  <ChannelContent
    blockHrefBase="/blocks"
    channelHref={channelUrl}
    description={description}
    entries={entries}
    title={title}
  >
    <Annotation slot="status">
      {channel ? (
        <p>
          The build contains {entries.length} private entries from the channel <a href={channelUrl}>{title}</a>.
        </p>
      ) : (
        <p>
          The private example is inactive. Add <code>ARENA_BEARER_TOKEN</code> to <code>.env</code> to enable it.
        </p>
      )}
    </Annotation>
  </ChannelContent>
</Layout>
