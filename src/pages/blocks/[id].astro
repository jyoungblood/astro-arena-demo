---
import type { CollectionEntry } from "astro:content";
import { getCollection, render } from "astro:content";
import BlockContent from "../../components/BlockContent.astro";
import Layout from "../../components/Layout.astro";
import { privateConfiguration } from "../../private.config";

type BlockEntry =
  | CollectionEntry<"liveSnapshot">
  | CollectionEntry<"privateReferences">
  | CollectionEntry<"references">;

export async function getStaticPaths() {
  const collections = await Promise.all([
    getCollection("references"),
    ...(privateConfiguration ? [getCollection("privateReferences")] : []),
    getCollection("liveSnapshot"),
  ]);
  const entries = new Map<string, BlockEntry>();

  for (const collection of collections) {
    for (const entry of collection) {
      entries.set(entry.id, entry);
    }
  }

  return Array.from(entries.values(), (entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: BlockEntry };
const { Content } = await render(entry);
---

<Layout title={entry.data.title || `Block ${entry.id}`}>
  <BlockContent data={entry.data} id={entry.id}>
    <Content />
  </BlockContent>
</Layout>
