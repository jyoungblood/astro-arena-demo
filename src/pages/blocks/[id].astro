---
export const prerender = false;

import { getEntry, getLiveEntry, render } from "astro:content";
import BlockContent from "../../components/BlockContent.astro";
import Layout from "../../components/Layout.astro";

const id = Astro.params.id;
if (!id) {
  throw new Error("A block ID is required.");
}

const staticEntry =
  await getEntry("references", id) ??
  await getEntry("privateReferences", id);
const liveResult = staticEntry
  ? undefined
  : await getLiveEntry("liveReferences", id);

if (liveResult?.error) {
  throw liveResult.error;
}

const entry = staticEntry ?? liveResult?.entry;
if (!entry) {
  Astro.response.status = 404;
}

const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
---

<Layout title={entry?.data.title || `Block ${id}`}>
  {entry ? (
    <BlockContent data={entry.data} id={entry.id}>
      {Content && <Content />}
    </BlockContent>
  ) : (
    <div class="content">
      <h1>Block not found</h1>
      <p>No block with ID {id} was found in the demo collections.</p>
    </div>
  )}
</Layout>
