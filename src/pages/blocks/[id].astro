---
export const prerender = true;

import { getCollection, render, type CollectionEntry } from "astro:content";
import BlockContent from "../../components/BlockContent.astro";
import Layout from "../../components/Layout.astro";

export async function getStaticPaths() {
  const entries = await getCollection("references", ({ data }) => data.type !== "Channel");
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<"references">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title || `Block ${entry.id}`}>
  <BlockContent data={entry.data} id={entry.id}>
    <Content />
  </BlockContent>
</Layout>
